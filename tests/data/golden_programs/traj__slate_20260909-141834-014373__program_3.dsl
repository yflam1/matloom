
View(0, 0, 1, 1)
Define(mottle, fBm(octaves=4, base_freq=9, to_01=True, seed=21))
Define(grain, fBm(octaves=3, base_freq=210, to_01=True, seed=83))
Define(corrosion, fBm(octaves=5, lacunarity=2.1, gain=0.56, base_freq=3.8, to_01=True, seed=46))
Define(rustgrain, fBm(octaves=4, base_freq=75, to_01=True, seed=59))
Define(strikes, Worley(distance="euclidean", combination="F1", base_freq_x=8, base_freq_y=11, to_01=True, seed=12))
Define(overlaps, Rotate(Worley(distance="euclidean", combination="F1", base_freq_x=19, base_freq_y=12, to_01=True, seed=67), 31))
Define(strike_variation, fBm(octaves=2, base_freq=14, to_01=True, seed=144))
Define(strike_radius, (strikes * (2.2 + (2.7 * strike_variation))))
Define(overlap_radius, (overlaps * (2.8 + mottle)))
Define(dents, (Max(0, (1 - strike_radius)) ** 1.15))
Define(small_dents, (Max(0, (1 - overlap_radius)) ** 1.35))
Define(rims, (Max(0, (1 - (Abs((strike_radius - 0.82)) / 0.19))) ** 2))
Define(overlap_rims, (Max(0, (1 - (Abs((overlap_radius - 0.8)) / 0.2))) ** 2))
Define(hammer, (((((-0.0035 * dents) * (0.3 + strike_variation)) - ((0.0015 * small_dents) * mottle)) + ((0.00038 * rims) * strike_variation)) + (0.00018 * overlap_rims)))
Define(zinc_a, Rotate(Worley(distance="manhattan", combination="F1", base_freq_x=38, base_freq_y=54, to_01=True, seed=37), 23))
Define(zinc_b, Rotate(Worley(distance="manhattan", combination="F2-F1", base_freq_x=53, base_freq_y=41, to_01=True, seed=104), -38))
Define(crystal_field, fBm(octaves=1, base_freq_x=43, base_freq_y=56, to_01=True, seed=172))
Define(crystal_steps, (Floor((crystal_field * 6)) / 6))
Define(crystal_tone, Threshold((((0.6 * crystal_steps) + (0.25 * zinc_a)) + (0.15 * zinc_b)), below_at=0, above_at=1))
Define(weather, Threshold(mottle, below_at=0.62, below_to=0, above_at=0.62, above_to=1, transition_width=0.13))
Define(rustfield, ((corrosion + (0.11 * (rustgrain - 0.5))) + (0.035 * (grain - 0.5))))
Define(patches, Threshold(rustfield, below_at=0.605, below_to=0, above_at=0.605, above_to=1, transition_width=0.065))
Define(pitfield, Worley(distance="euclidean", combination="F1", base_freq=112, to_01=True, seed=93))
Define(pitshape, (1 - Threshold(pitfield, below_at=0.15, below_to=0, above_at=0.15, above_to=1, transition_width=0.055)))
Define(pits, (pitshape * patches))
Define(flecks, ((0.65 * Threshold(grain, below_at=0.72, below_to=0, above_at=0.72, above_to=1, transition_width=0.035)) * Threshold(corrosion, below_at=0.55, below_to=0, above_at=0.55, above_to=1, transition_width=0.05)))
Define(rust, Max(patches, flecks))
Define(stains, (Threshold(corrosion, below_at=0.53, below_to=0, above_at=0.53, above_to=1, transition_width=0.13) * (0.1 + (0.23 * rustgrain))))
Define(brownfield, fBm(octaves=3, base_freq=17, to_01=True, seed=118))
Define(center, Threshold(corrosion, below_at=0.635, below_to=0, above_at=0.635, above_to=1, transition_width=0.075))
Define(orange, Threshold((((0.52 * brownfield) + (0.48 * rustgrain)) - (0.22 * center)), below_at=0.43, below_to=0, above_at=0.43, above_to=1, transition_width=0.24))
Define(crust, ((0.00065 * (rustgrain ** 2)) + (0.0004 * (grain ** 3))))
Define(relief, ((hammer + (3.5e-05 * grain)) - (0.0008 * pits)))
Material(
  Layer(1)
    .basecolor(((210 + (40 * crystal_tone)) - (24 * weather)), ((216 + (34 * crystal_tone)) - (25 * weather)), ((220 + (30 * crystal_tone)) - (26 * weather)))
    .metallic(0.9)
    .roughness(((0.24 + (0.09 * crystal_steps)) + (0.08 * weather)))
    .height(relief),
  Layer(stains)
    .basecolor((121 + (25 * rustgrain)), (77 + (15 * rustgrain)), (43 + (9 * rustgrain)))
    .metallic(0.72)
    .roughness(0.49)
    .height(relief),
  Layer(rust)
    .basecolor(((((83 + (78 * orange)) + (21 * rustgrain)) - (22 * center)) - (19 * pitshape)), ((((36 + (34 * orange)) + (12 * rustgrain)) - (9 * center)) - (8 * pitshape)), (((21 + (9 * orange)) + (6 * rustgrain)) - (4 * center)))
    .metallic(0.01)
    .roughness((0.85 + (0.13 * rustgrain)))
    .height((relief + ((crust * patches) * (1 - pitshape))))
)
  