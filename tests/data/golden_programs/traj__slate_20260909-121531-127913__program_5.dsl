Define(edgeDamage, Threshold(fBm(octaves=2, base_freq_x=7, base_freq_y=4, to_01=True, seed=285), below_at=0.7, below_to=0, above_at=0.82, above_to=1, transition_width=0.06))
Define(sideMask, Threshold((((edgeDistance - (0.0015 + (0.0045 * seamVariation))) - (0.012 * edgeDamage)) / 0.005), below_at=0, above_at=1))
Define(endMask, Threshold((((endDistance - (0.002 + (0.004 * boardTone))) - ((0.009 * edgeDamage) * (2.718281828459045 ** (-edgeDistance * 15)))) / 0.005), below_at=0, above_at=1))
Define(chipA, Fill(Path(0.79, 1.116, LineTo(0.806, 1.133), LineTo(0.835, 1.137), LineTo(0.864, 1.123), LineTo(0.88, 1.116), LineTo(0.79, 1.116)), feather=0.002))
Define(chipB, Fill(Path(2.7, 2.229, LineTo(2.728, 2.21), LineTo(2.749, 2.207), LineTo(2.787, 2.223), LineTo(2.806, 2.229), LineTo(2.7, 2.229)), feather=0.002))
Define(chips, Max(chipA, chipB))
Define(planks, ((sideMask * endMask) * (1 - chips)))
Define(edgeRound, (1 - Threshold(((Min(edgeDistance, endDistance) - 0.006) / (0.013 + (0.017 * seamVariation))), below_at=0, above_at=1)))
Define(wornEdge, (edgeRound * (0.2 + (0.8 * ageNoise))))
Define(flow, fBm(octaves=3, base_freq_x=0.32, base_freq_y=5.5, seed=119))
Define(longGrain, fBm(octaves=4, base_freq_x=0.38, base_freq_y=23, to_01=True, seed=131))
Define(knotA, Sqrt(((((X() - 1.08) / 0.24) ** 2) + (((Y() - 0.25) / 0.074) ** 2))))
Define(knotB, Sqrt(((((X() - 3.12) / 0.19) ** 2) + (((Y() - 1.89) / 0.068) ** 2))))
Define(knotC, Sqrt(((((X() - 0.62) / 0.21) ** 2) + (((Y() - 3.55) / 0.072) ** 2))))
Define(knotDistance, Min(knotA, Min(knotB, knotC)))
Define(knotRegion, (1 - Threshold(((knotDistance - 0.9) / 1.35), below_at=0, above_at=1)))
Define(knotCore, (1 - Threshold(((knotDistance - 0.2) / 0.19), below_at=0, above_at=1)))
Define(bend, (((19 * (2.718281828459045 ** ((-knotA * knotA) * 0.15))) - (17 * (2.718281828459045 ** ((-knotB * knotB) * 0.16)))) + (18 * (2.718281828459045 ** ((-knotC * knotC) * 0.16)))))
Define(grainPhase, ((((rowPosition * (135 + (70 * boardTone))) + (flow * 12)) + (Sin(((warpY * 31) + (flow * 2))) * 4.5)) + bend))
Define(grainWidth, (4 + (7 * mottling)))
Define(flowingLines, ((0.5 + (0.5 * Sin(grainPhase))) ** grainWidth))
Define(fineLines, (((0.5 + (0.5 * Sin(((grainPhase * 2.63) + (longGrain * 6))))) ** 11) * Threshold(((fibers - 0.35) / 0.26), below_at=0, above_at=1)))
Define(knotRings, ((0.5 + (0.5 * Sin((((knotDistance * 20) + (flow * 2.2)) + (longGrain * 1.4))))) ** 6))
Define(grainLines, (((flowingLines * (1 - knotRegion)) + (knotRings * knotRegion)) * (0.5 + (0.5 * mottling))))
Define(fiberNoise, fBm(octaves=3, base_freq_x=4.5, base_freq_y=95, to_01=True, seed=252))
Define(fiberRecess, Threshold(fiberNoise, below_at=0.61, below_to=0, above_at=0.68, above_to=1, transition_width=0.018))
