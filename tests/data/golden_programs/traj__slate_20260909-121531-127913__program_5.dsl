
View(0, 0, 4, 4)
Define(fibers, fBm(octaves=3, base_freq_x=2.4, base_freq_y=145, to_01=True, seed=42))
Define(warpY, ((Y() + (0.038 * Sin((Y() * 5.3)))) + (0.0025 * Sin(((X() * 3.1) + (Y() * 11))))))
Define(row, Floor((warpY / 0.55)))
