Define(crackB, Stroke(Path(2.58, 1.88, CubicTo(2.77, 1.87, 2.98, 1.908, 3.14, 1.889), CubicTo(3.35, 1.866, 3.49, 1.899, 3.66, 1.897)), 0.006, feather=0.0015))
Define(crackC, Stroke(Path(0.03, 2.695, CubicTo(0.29, 2.71, 0.49, 2.681, 0.77, 2.697), CubicTo(0.88, 2.701, 0.96, 2.689, 1.08, 2.694)), 0.009, feather=0.0015))
Define(branch, Stroke(Path(1.69, 0.262, CubicTo(1.85, 0.272, 1.95, 0.306, 2.12, 0.305)), 0.003, feather=0.001))
Define(branchB, Stroke(Path(2.95, 1.889, CubicTo(2.83, 1.909, 2.75, 1.923, 2.55, 1.919)), 0.004, feather=0.001))
Define(branchC, Stroke(Path(0.48, 2.696, CubicTo(0.61, 2.677, 0.69, 2.66, 0.92, 2.664)), 0.004, feather=0.001))
Define(splitNoise, fBm(octaves=3, base_freq_x=3.2, base_freq_y=68, to_01=True, seed=217))
Define(endSplits, (Threshold(splitNoise, below_at=0.61, below_to=0, above_at=0.73, above_to=1, transition_width=0.035) * (2.718281828459045 ** (-endDistance * 7))))
Define(faceSplits, (Threshold(splitNoise, below_at=0.69, below_to=0, above_at=0.76, above_to=1, transition_width=0.02) * Threshold(((ageNoise - 0.42) / 0.25), below_at=0, above_at=1)))
Define(cracks, Max(Max(crackA, crackB), Max(Max(crackC, branch), Max(Max(branchB, branchC), Max(endSplits, faceSplits)))))
Define(abrasion, Threshold(((((mottling * 0.65) + (ageNoise * 0.35)) - 0.43) / 0.22), below_at=0, above_at=1))
Define(erosionPatch, Max(Fill(Ellipse(2.45, 0.83, 0.39, 0.095), feather=0.045), Fill(Ellipse(1.63, 3.04, 0.31, 0.072), feather=0.03)))
Define(erosion, (erosionPatch * Threshold(((fiberNoise - 0.45) / 0.18), below_at=0, above_at=1)))
Define(bleachNoise, fBm(octaves=3, base_freq_x=1.5, base_freq_y=14, to_01=True, seed=263))
Define(fading, Threshold((((((ageNoise * 0.2) + (bleachNoise * 0.46)) + (boardTone * 0.34)) - 0.4) / 0.19), below_at=0, above_at=1))
Define(exposed, (Threshold(((mottling - 0.56) / 0.15), below_at=0, above_at=1) * (0.3 + (0.7 * (1 - boardTone)))))
Define(stainNoise, fBm(octaves=4, base_freq_x=1.8, base_freq_y=3.4, to_01=True, seed=228))
Define(stainPatch, Threshold(((stainNoise - 0.55) / 0.15), below_at=0, above_at=1))
Define(stain, Threshold((((stainPatch * (0.3 + (0.55 * boardTone))) + (((2.718281828459045 ** (-endDistance * 10)) * ageNoise) * 0.36)) + (knotCore * 0.18)), below_at=0, above_at=1))
Define(surfaceRoughness, Threshold(((((0.72 + (0.18 * fading)) + (0.12 * abrasion)) + (0.05 * fibers)) - (0.09 * stainPatch)), below_at=0.65, above_at=0.98))
Define(relief, (((((((((((0.03 * planks) + (0.002 * longGrain)) + (0.0014 * fibers)) - (0.0036 * grainLines)) - (0.0018 * fineLines)) - (0.003 * fiberRecess)) - (0.011 * edgeRound)) - (0.002 * abrasion)) - (0.017 * cracks)) - (0.005 * knotCore)) - (0.009 * erosion)))
