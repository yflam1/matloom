Define(boardTone, (0.5 + (0.5 * Sin((((row * 17.31) + (column * 7.93)) + 2.6)))))
Define(ageNoise, fBm(octaves=4, base_freq_x=1.1, base_freq_y=6.5, to_01=True, seed=83))
Define(mottling, fBm(octaves=5, base_freq_x=2.1, base_freq_y=9, to_01=True, seed=206))
