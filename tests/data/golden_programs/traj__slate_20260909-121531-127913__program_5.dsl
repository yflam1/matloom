Define(boardLength, (2.35 + (0.65 * Sin(((row * 19.37) + 1.1)))))
Define(shiftX, (X() + (1.43 * Sin((row * 8.73)))))
Define(column, Floor((shiftX / boardLength)))
Define(endPosition, (shiftX - (column * boardLength)))
