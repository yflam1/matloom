
View(0, 0, 1, 1)
Define(mottle, fBm(octaves=4, base_freq=9, to_01=True, seed=21))
Define(grain, fBm(octaves=3, base_freq=210, to_01=True, seed=83))
Define(corrosion, fBm(octaves=5, lacunarity=2.1, gain=0.56, base_freq=3.8, to_01=True, seed=46))
Define(rustgrain, fBm(octaves=4, base_freq=75, to_01=True, seed=59))
Define(strike_variation, fBm(octaves=2, base_freq=14, to_01=True, seed=144))
Define(strikes, Worley(distance="euclidean", combination="F1", base_freq=9, to_01=True, seed=12))
Define(overlaps, Rotate(Worley(distance="euclidean", combination="F1", base_freq_x=17, base_freq_y=12, to_01=True, seed=67), 57))
Define(small_strikes, Rotate(Worley(distance="euclidean", combination="F1", base_freq_x=24, base_freq_y=28, to_01=True, seed=188), -24))
Define(strike_radius, (strikes * (1.8 + (3.4 * strike_variation))))
Define(overlap_radius, (overlaps * (2.2 + (2.5 * mottle))))
Define(dents, (Max(0, (1 - strike_radius)) ** 1.25))
Define(overlap_dents, (Max(0, (1 - overlap_radius)) ** 1.15))
Define(fine_dents, (Max(0, (1 - (small_strikes * 3.2))) ** 1.4))
Define(rims, (Max(0, (1 - (Abs((strike_radius - 0.83)) / 0.17))) ** 2))
Define(hammer, (((((-0.0038 * dents) * (0.25 + strike_variation)) - ((0.0019 * overlap_dents) * mottle)) - ((0.00065 * fine_dents) * strike_variation)) + ((0.00019 * rims) * mottle)))
Define(warp_x, fBm(octaves=2, base_freq=16, seed=219))
Define(warp_y, fBm(octaves=2, base_freq=14, seed=220))
Define(u, ((Rotate(X(), 21) + (0.011 * warp_x)) * 39))
Define(v, ((Rotate(Y(), 21) + (0.013 * warp_y)) * 47))
Define(row, Floor(v))
Define(rowhash, (Sin(((row * 127.1) + 23.7)) * 43758.5453))
Define(rowshift, (rowhash - Floor(rowhash)))
Define(su, ((u * (0.75 + (0.5 * rowshift))) + rowshift))
Define(col, Floor(su))
Define(fu, (su - col))
Define(fv, (v - row))
Define(diagonal, Threshold((fu + fv), below_at=1, below_to=0, above_at=1, transition_width=0.012))
Define(cellhash, (Sin(((col * 127.1) + (row * 311.7))) * 43758.5453))
Define(cell_tone, (cellhash - Floor(cellhash)))
Define(facethash, (Sin((((col * 173.3) + (row * 269.5)) + (diagonal * 71.9))) * 19341.731))
Define(facet_tone, (facethash - Floor(facethash)))
Define(zinc, ((0.72 * cell_tone) + (0.28 * facet_tone)))
Define(weather, Threshold(mottle, below_at=0.62, below_to=0, above_at=0.62, above_to=1, transition_width=0.13))
Define(rustfield, ((corrosion + (0.14 * (rustgrain - 0.5))) + (0.055 * (grain - 0.5))))
Define(patches, Threshold(rustfield, below_at=0.612, below_to=0, above_at=0.612, above_to=1, transition_width=0.045))
Define(pitfield, Worley(distance="euclidean", combination="F1", base_freq=112, to_01=True, seed=93))
Define(pitshape, (1 - Threshold(pitfield, below_at=0.15, below_to=0, above_at=0.15, above_to=1, transition_width=0.055)))
Define(margins, Threshold(corrosion, below_at=0.535, below_to=0, above_at=0.535, above_to=1, transition_width=0.105))
Define(pits, (pitshape * Max(patches, (0.6 * margins))))
Define(flecks, (Threshold(grain, below_at=0.675, below_to=0, above_at=0.675, above_to=1, transition_width=0.04) * margins))
Define(rust, Max(patches, Max(flecks, pits)))
Define(stains, (margins * (0.2 + (0.42 * rustgrain))))
Define(brownfield, fBm(octaves=3, base_freq=17, to_01=True, seed=118))
Define(center, Threshold(corrosion, below_at=0.635, below_to=0, above_at=0.635, above_to=1, transition_width=0.075))
Define(orange, Threshold((((0.52 * brownfield) + (0.48 * rustgrain)) - (0.22 * center)), below_at=0.43, below_to=0, above_at=0.43, above_to=1, transition_width=0.24))
Define(crust, ((0.00036 * (rustgrain ** 2)) + (0.00028 * (grain ** 3))))
Define(relief, ((hammer + (2.5e-05 * grain)) - (0.00065 * pits)))
Material(
  Layer(1)
    .basecolor(((190 + (55 * zinc)) - (23 * weather)), ((197 + (49 * zinc)) - (24 * weather)), ((202 + (44 * zinc)) - (25 * weather)))
    .metallic(0.96)
    .roughness(((0.23 + (0.12 * facet_tone)) + (0.065 * weather)))
    .height(relief),
  Layer(stains)
    .basecolor((136 + (24 * rustgrain)), (80 + (19 * rustgrain)), (38 + (12 * rustgrain)))
    .metallic(0.72)
    .roughness((0.47 + (0.1 * rustgrain)))
    .height(relief),
  Layer(rust)
    .basecolor(((((83 + (84 * orange)) + (20 * rustgrain)) - (24 * center)) - (24 * pitshape)), ((((35 + (37 * orange)) + (12 * rustgrain)) - (10 * center)) - (10 * pitshape)), ((((19 + (10 * orange)) + (7 * rustgrain)) - (5 * center)) - (5 * pitshape)))
    .metallic(0.01)
    .roughness((0.86 + (0.12 * rustgrain)))
    .height((relief + ((crust * patches) * (1 - pitshape))))
)
  