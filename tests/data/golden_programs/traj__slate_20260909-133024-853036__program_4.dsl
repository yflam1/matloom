
View(0, 0, 4, 4)
Define(tilehash, (Sin((((Floor(X()) * 127.1) + (Floor(Y()) * 311.7)) + 19)) * 43758.5453))
Define(tilevar, (tilehash - Floor(tilehash)))
Define(edge, Min(Min((X() - Floor(X())), (1 - (X() - Floor(X())))), Min((Y() - Floor(Y())), (1 - (Y() - Floor(Y()))))))
Define(edgegrain, fBm(octaves=2, base_freq=18, seed=71))
Define(tiles, Threshold((edge + (0.0007 * edgegrain)), below_at=0.014, below_to=0, above_at=0.014, above_to=1, transition_width=0.005))
Define(stone, Translate(fBm(octaves=5, base_freq=3.8, to_01=True, seed=17), 6.947364056260994, 12.668722690828872))
Define(cleavage, Translate(Rotate(fBm(octaves=4, base_freq_x=7, base_freq_y=16, to_01=True, seed=31), 19), 9.399374899647228, 4.495353212874761))
Define(flakes, Threshold((((0.65 * stone) + (0.35 * cleavage)) + (0.055 * (tilevar - 0.5))), below_at=0.54, below_to=0, above_at=0.54, above_to=1, transition_width=0.025))
Define(layerfield, (((22 * stone) + (11 * cleavage)) + (8 * tilevar)))
Define(lamina, Threshold(Sin(layerfield), below_at=0.18, below_to=0, above_at=0.18, above_to=1, transition_width=0.3))
Define(clefts, ((1 - Threshold(Abs(Sin(layerfield)), below_at=0.025, below_to=0, above_at=0.19, above_to=1)) * Threshold(stone, below_at=0.4, below_to=0, above_at=0.58, above_to=1)))
Define(angular, ((1 - Threshold(Worley(distance="euclidean", combination="F2-F1", base_freq=3.2, to_01=True, seed=89), below_at=0.012, below_to=0, above_at=0.045, above_to=1)) * Threshold(cleavage, below_at=0.52, below_to=0, above_at=0.63, above_to=1)))
Define(grain, fBm(octaves=3, base_freq=115, to_01=True, seed=53))
Define(bevel, Threshold(((edge - 0.012) / 0.025), below_at=0, above_at=1))
Define(charcoal, ((lamina * Threshold(cleavage, below_at=0.46, below_to=0, above_at=0.62, above_to=1)) * (0.55 + (0.45 * tilevar))))
Define(tone, ((((((17 + (8 * tilevar)) + (8 * stone)) + (3 * cleavage)) + (2 * flakes)) + (2 * grain)) + (6 * charcoal)))
Material(
  Layer(1)
    .basecolor((231 + (8 * grain)), (230 + (8 * grain)), (224 + (9 * grain)))
    .roughness(0.88)
    .height((0.0008 * grain)),
  Layer(tiles)
    .basecolor(((tone - (1.5 * clefts)) - (2 * angular)), (((tone + 1) - (1.5 * clefts)) - (2 * angular)), (((tone + 2) - (1.5 * clefts)) - (2 * angular)))
    .roughness(((0.76 + (0.1 * stone)) + (0.04 * grain)))
    .height(((((((((0.003 + (0.008 * bevel)) + (0.002 * stone)) + (0.0015 * cleavage)) + (0.0022 * flakes)) + (0.0013 * lamina)) - (0.0008 * clefts)) - (0.0012 * angular)) + (0.00045 * grain)))
)
  