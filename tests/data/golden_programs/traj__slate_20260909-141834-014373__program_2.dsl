
View(0, 0, 1, 1)
Define(mottle, fBm(octaves=4, base_freq=9, to_01=True, seed=21))
Define(grain, fBm(octaves=3, base_freq=210, to_01=True, seed=83))
Define(corrosion, fBm(octaves=5, lacunarity=2.1, gain=0.56, base_freq=3.8, to_01=True, seed=46))
Define(rustgrain, fBm(octaves=4, base_freq=75, to_01=True, seed=59))
Define(strikes, Worley(distance="euclidean", combination="F1", base_freq_x=8, base_freq_y=11, to_01=True, seed=12))
Define(overlaps, Rotate(Worley(distance="euclidean", combination="F1", base_freq_x=19, base_freq_y=12, to_01=True, seed=67), 31))
Define(strike_variation, fBm(octaves=2, base_freq=14, to_01=True, seed=144))
Define(dents, (Max(0, (1 - (strikes * (2.2 + (2.7 * strike_variation))))) ** 1.4))
Define(small_dents, (Max(0, (1 - (overlaps * (2.8 + mottle)))) ** 1.8))
Define(hammer, (((-0.0027 * dents) * (0.25 + strike_variation)) - ((0.0011 * small_dents) * mottle)))
Define(zinc_a, Rotate(Worley(distance="manhattan", combination="F1", base_freq_x=57, base_freq_y=83, to_01=True, seed=37), 23))
Define(zinc_b, Rotate(Worley(distance="manhattan", combination="F2-F1", base_freq_x=89, base_freq_y=66, to_01=True, seed=104), -38))
Define(facets, Threshold(((zinc_a * 0.6) + (zinc_b * 0.4)), below_at=0.4, below_to=0, above_at=0.4, above_to=1, transition_width=0.025))
Define(crystal_tone, ((0.55 * facets) + (0.45 * zinc_b)))
Define(weather, Threshold(mottle, below_at=0.57, below_to=0, above_at=0.57, above_to=1, transition_width=0.18))
Define(rustfield, ((corrosion + (0.11 * (rustgrain - 0.5))) + (0.035 * (grain - 0.5))))
Define(patches, Threshold(rustfield, below_at=0.605, below_to=0, above_at=0.605, above_to=1, transition_width=0.065))
Define(pitfield, Worley(distance="euclidean", combination="F1", base_freq=112, to_01=True, seed=93))
Define(pits, ((1 - Threshold(pitfield, below_at=0.095, below_to=0, above_at=0.095, above_to=1, transition_width=0.025)) * Threshold(corrosion, below_at=0.49, below_to=0, above_at=0.49, above_to=1, transition_width=0.06)))
Define(flecks, (Threshold(grain, below_at=0.66, below_to=0, above_at=0.66, above_to=1, transition_width=0.035) * Threshold(corrosion, below_at=0.52, below_to=0, above_at=0.52, above_to=1, transition_width=0.08)))
Define(rust, Max(patches, Max(pits, flecks)))
Define(stains, (Threshold(corrosion, below_at=0.505, below_to=0, above_at=0.505, above_to=1, transition_width=0.16) * (0.17 + (0.36 * rustgrain))))
Define(brownfield, fBm(octaves=3, base_freq=17, to_01=True, seed=118))
Define(orange, Threshold(((0.65 * brownfield) + (0.35 * rustgrain)), below_at=0.47, below_to=0, above_at=0.47, above_to=1, transition_width=0.19))
Define(dark, Threshold(rustgrain, below_at=0.62, below_to=0, above_at=0.62, above_to=1, transition_width=0.09))
Define(relief, ((hammer + (8e-05 * grain)) - (0.00038 * pits)))
Define(granules, ((0.00017 * rustgrain) + (0.0002 * (grain ** 3))))
Material(
  Layer(1)
    .basecolor(((191 + (43 * crystal_tone)) - (35 * weather)), ((198 + (38 * crystal_tone)) - (36 * weather)), ((202 + (35 * crystal_tone)) - (37 * weather)))
    .metallic(0.99)
    .roughness(((0.23 + (0.095 * (1 - facets))) + (0.1 * weather)))
    .height(relief),
  Layer(stains)
    .basecolor((112 + (28 * rustgrain)), 70, 40)
    .metallic(0.72)
    .roughness(0.49)
    .height(relief),
  Layer(rust)
    .basecolor((((87 + (91 * orange)) + (21 * grain)) - (38 * dark)), (((35 + (40 * orange)) + (14 * grain)) - (18 * dark)), (((20 + (9 * orange)) + (7 * grain)) - (8 * dark)))
    .metallic(0.02)
    .roughness((0.83 + (0.14 * rustgrain)))
    .height(((relief + (granules * patches)) + (8e-05 * flecks)))
)
  