
View(0, 0, 1, 1)
Define(mottle, fBm(octaves=4, base_freq=9, to_01=True, seed=21))
Define(grain, fBm(octaves=3, base_freq=210, to_01=True, seed=83))
Define(corrosion, fBm(octaves=5, lacunarity=2.1, gain=0.56, base_freq=3.8, to_01=True, seed=46))
Define(rustgrain, fBm(octaves=4, base_freq=75, to_01=True, seed=59))
Define(strikes, Worley(distance="euclidean", combination="F1", base_freq_x=11, base_freq_y=14, to_01=True, seed=12))
Define(overlaps, Rotate(Worley(distance="euclidean", combination="F1", base_freq_x=22, base_freq_y=16, to_01=True, seed=67), 31))
Define(dents, (Max(0, (1 - (strikes * (2.1 + (1.8 * mottle))))) ** 2))
Define(small_dents, (Max(0, (1 - (overlaps * 3.1))) ** 2))
Define(relief, ((((-0.0032 * dents) * (0.35 + mottle)) - (0.0013 * small_dents)) + (0.00012 * grain)))
Define(spangle, Rotate(Worley(distance="manhattan", combination="F2-F1", base_freq_x=83, base_freq_y=106, to_01=True, seed=37), 19))
Define(crystal, Threshold(spangle, below_at=0.43, below_to=0, above_at=0.43, above_to=1, transition_width=0.035))
Define(silver, fBm(octaves=2, base_freq=96, to_01=True, seed=104))
Define(rustfield, (corrosion + (0.045 * (rustgrain - 0.5))))
Define(patches, Threshold(rustfield, below_at=0.598, below_to=0, above_at=0.598, above_to=1, transition_width=0.035))
Define(pitfield, Worley(distance="euclidean", combination="F1", base_freq=112, to_01=True, seed=93))
Define(pits, ((1 - Threshold(pitfield, below_at=0.065, below_to=0, above_at=0.065, above_to=1, transition_width=0.018)) * Threshold(corrosion, below_at=0.49, below_to=0, above_at=0.49, above_to=1, transition_width=0.06)))
Define(rust, Max(patches, pits))
Define(stains, ((Threshold(corrosion, below_at=0.54, below_to=0, above_at=0.54, above_to=1, transition_width=0.09) * (1 - rust)) * (0.08 + (0.18 * rustgrain))))
Define(brownfield, fBm(octaves=3, base_freq=17, to_01=True, seed=118))
Define(orange, Threshold(brownfield, below_at=0.41, below_to=0, above_at=0.58, above_to=1, transition_width=0.14))
Material(
  Layer(1)
    .basecolor((((166 + (27 * crystal)) + (19 * silver)) + (7 * mottle)), (((173 + (26 * crystal)) + (18 * silver)) + (7 * mottle)), (((177 + (26 * crystal)) + (18 * silver)) + (7 * mottle)))
    .metallic(0.98)
    .roughness((((0.32 + (0.07 * crystal)) + (0.1 * mottle)) + (0.025 * grain)))
    .height(relief),
  Layer(stains)
    .basecolor((123 + (32 * rustgrain)), (87 + (23 * rustgrain)), (48 + (17 * rustgrain)))
    .metallic(0.78)
    .roughness(0.53)
    .height(relief),
  Layer(rust)
    .basecolor(((66 + (94 * orange)) + (24 * rustgrain)), ((31 + (36 * orange)) + (17 * rustgrain)), ((17 + (9 * orange)) + (9 * rustgrain)))
    .metallic(0.03)
    .roughness((0.8 + (0.16 * rustgrain)))
    .height(((relief + ((0.00028 * rustgrain) * patches)) - (0.0002 * pits)))
)
  