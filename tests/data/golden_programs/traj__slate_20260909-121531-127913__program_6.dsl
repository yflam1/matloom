Define(knotCore, (1 - Threshold(((knotDistance - 0.12) / 0.39), below_at=0, above_at=1)))
Define(bend, (((17 * (2.718281828459045 ** ((-knotA * knotA) * 0.18))) - (15 * (2.718281828459045 ** ((-knotB * knotB) * 0.19)))) + (16 * (2.718281828459045 ** ((-knotC * knotC) * 0.19)))))
Define(grainPhase, ((((warpY * 255) + (flow * 17)) + (Sin(((warpY * 43) + (flow * 3))) * 3.4)) + bend))
