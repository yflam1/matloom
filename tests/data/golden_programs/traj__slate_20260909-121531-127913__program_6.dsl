Define(faceSplits, (Threshold(splitNoise, below_at=0.72, below_to=0, above_at=0.79, above_to=1, transition_width=0.035) * Threshold(((ageNoise - 0.42) / 0.25), below_at=0, above_at=1)))
Define(cracks, Max(Max(crackA, crackB), Max(Max(crackC, branch), Max(Max(branchB, branchC), Max(endSplits, faceSplits)))))
