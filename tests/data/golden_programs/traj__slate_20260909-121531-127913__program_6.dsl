
View(0, 0, 4, 4)
Define(fibers, fBm(octaves=3, base_freq_x=2.4, base_freq_y=145, to_01=True, seed=467778288))
Define(warpY, ((Y() + (0.038 * Sin((Y() * 5.3)))) + (0.002 * Sin(((X() * 3.7) + (Y() * 11))))))
