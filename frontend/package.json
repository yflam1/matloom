{
  "name": "matloom-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The MatLoom web site: paper project page plus interactive viewer for the layered-material DSL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:check": "node scripts/check-build-artifacts.mjs",
    "build:verify": "npm run build && npm run build:check && npm run test:smoke",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "npx playwright test --config playwright.config.ts",
    "bench": "npx vite-node test/bench/engine.bench.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.11.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bulma": "^1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.11"
  }
}
